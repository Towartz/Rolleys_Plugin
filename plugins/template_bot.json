          "nextStep": "t_form_name",
          "stepTtlSec": 600
        },
        ".forms": [
          {
            "method": "dbQuery",
            "args": {
              "sql": "CREATE TABLE IF NOT EXISTS forms (_id INTEGER PRIMARY KEY AUTOINCREMENT, jid TEXT, nama TEXT, umur TEXT, created TEXT)"
            },
            "saveAs": "mk",
            "onError": "❌ Database error: {error}"
          },
          {
            "method": "dbQuery",
            "args": {
              "sql": "SELECT group_concat('#' || _id || ' ' || nama || ' (' || umur || ' th)', char(10)) AS list FROM (SELECT _id, nama, umur FROM forms WHERE jid = ? ORDER BY _id DESC LIMIT 5)",
              "params": [
                "{senderJid}"
              ]
            },
            "saveAs": "db",
            "onError": "❌ Database error: {error}"
          },
          {
            "when": "{db.first.list}",
            "notEmpty": true,
            "then": [
              {
                "reply": "📒 5 data terakhir kamu:\n{db.first.list}"
              }
            ],
            "else": [
              {
                "reply": "📭 Belum ada data. Isi dulu dengan .form"
              }
            ]
          }
        ],
