            "reply": "🍴 Kamu memilih {buttonText}\nID baris: {buttonId}",
            "buttons": [
              {
                "type": "quick_reply",
                "id": "t_menu",
                "text": "🏠 Menu Template"
              }
            ]
          }
        ]
      },
      {
        "buttonIdPrefix": "t_sel_",
        "actions": [
          {
            "reply": "🎯 Dipilih: {buttonText}\nID: {buttonId}"
          }
        ]
      },
      {
        "buttonId": "t_car_pick",
        "actions": [
          {
            "reply": "🃏 Kamu memilih kartu dengan indeks {cardIndex}.",
            "buttons": [
              {
                "type": "quick_reply",
                "id": "t_menu",
                "text": "🏠 Menu Template"
              }
            ]
          }
        ]
      },
      {
        "buttonId": "t_media_ok",
        "actions": [
          {
            "reply": "😄 Terima kasih!"
          }
        ]
      },
      {
        "step": "t_confirm",
        "buttonId": "t_yes",
        "clearStep": true,
        "actions": [
          {
            "reply": "✅ Dilanjutkan."
          }
        ]
      },
      {
        "step": "t_confirm",
        "buttonId": "t_no",
        "clearStep": true,
        "actions": [
          {
            "reply": "❌ Dibatalkan."
          }
        ]
      },
      {
        "buttonIdPrefix": "t_rate_",
        "actions": [
          {
            "reply": "🙏 Terima kasih! Rating kamu: {buttonText}"
          }
        ]
      },
      {
        "step": "t_form_name",
        "messageType": "text",
        "always": true,
        "actions": [
          {
            "remember": "t_fn_{chat}_{senderNumber}",
            "value": "{text}",
            "ttlSec": 900
          },
          {
            "reply": "📝 Form 2/3\nHalo {text}. Berapa umur kamu? Kirim angka.",
            "nextStep": "t_form_age",
            "stepTtlSec": 600
          }
        ]
      },
      {
        "step": "t_form_age",
        "messageType": "text",
        "regex": "^\\s*\\d{1,3}\\s*$",
        "actions": [
          {
            "remember": "t_fa_{chat}_{senderNumber}",
            "value": "{text|trim}",
            "ttlSec": 900
          },
          {
            "recall": "t_fn_{chat}_{senderNumber}",
            "default": "-",
            "saveAs": "nm"
          },
          {
            "reply": "📝 Form 3/3\nNama: {nm}\nUmur: {text|trim}\n\nSimpan data ini?",
            "nextStep": "t_form_confirm",
            "stepTtlSec": 600,
            "buttons": [
              {
                "type": "quick_reply",
                "id": "t_form_ok",
                "text": "💾 Simpan"
              },
              {
                "type": "quick_reply",
                "id": "t_form_no",
                "text": "❌ Batal"
              }
            ]
          }
        ]
      },
      {
        "step": "t_form_age",
        "messageType": "text",
        "always": true,
        "actions": [
          {
            "reply": "⚠️ Umur harus berupa angka. Coba lagi."
          }
        ]
      },
      {
        "step": "t_form_confirm",
        "buttonId": "t_form_ok",
        "clearStep": true,
        "actions": [
          {
            "recall": "t_fn_{chat}_{senderNumber}",
            "default": "-",
            "saveAs": "nm"
          },
          {
            "recall": "t_fa_{chat}_{senderNumber}",
            "default": "0",
            "saveAs": "ag"
          },
          {
            "method": "dbInsert",
            "args": {
              "table": "forms",
              "data": {
                "jid": "{senderJid}",
                "nama": "{nm}",
                "umur": "{ag}",
                "created": "{date} {time}"
              }
            },
            "saveAs": "db",
            "onError": "❌ Database error: {error}"
          },
          {
            "forget": "t_fn_{chat}_{senderNumber}"
          },
          {
            "forget": "t_fa_{chat}_{senderNumber}"
          },
          {
            "reply": "✅ Data tersimpan dengan nomor #{db.lastInsertRowid}.\nLihat semua dengan .forms",
            "buttons": [
              {
                "type": "quick_reply",
                "id": "t_menu",
                "text": "🏠 Menu Template"
              }
            ]
          }
        ]
      },
      {
        "step": "t_form_confirm",
        "buttonId": "t_form_no",
        "clearStep": true,
        "actions": [
          {
            "reply": "❌ Form dibatalkan."
          }
        ]
      },
      {
        "step": "t_shop_item",
        "buttonIdPrefix": "t_item_",
        "actions": [
          {
            "remember": "t_si_{chat}_{senderNumber}",
            "value": "{buttonText}",
            "ttlSec": 900
          },
          {
            "when": "{buttonId}",
            "is": "t_item_kopi",
            "then": [
              {
                "remember": "t_sp_{chat}_{senderNumber}",
                "value": "18000",
                "ttlSec": 900
              }
            ],
            "else": [
              {
                "when": "{buttonId}",
                "is": "t_item_teh",
                "then": [
                  {
                    "remember": "t_sp_{chat}_{senderNumber}",
                    "value": "15000",
                    "ttlSec": 900
                  }
                ],
                "else": [
                  {
                    "remember": "t_sp_{chat}_{senderNumber}",
                    "value": "20000",
                    "ttlSec": 900
                  }
                ]
              }
            ]
          },
          {
            "list": {
              "title": "🛒 Jumlah",
              "description": "Langkah 2/3. Berapa porsi {buttonText}?",
              "buttonText": "Pilih Jumlah",
              "sections": [
                {
                  "title": "Jumlah",
                  "rows": [
                    {
                      "id": "t_qty_1",
                      "title": "1",
                      "description": "1 porsi"
                    },
                    {
                      "id": "t_qty_2",
                      "title": "2",
                      "description": "2 porsi"
                    },
                    {
                      "id": "t_qty_3",
                      "title": "3",
                      "description": "3 porsi"
                    },
                    {
                      "id": "t_qty_5",
                      "title": "5",
                      "description": "5 porsi"
                    }
                  ]
                }
              ]
            },
            "nextStep": "t_shop_qty",
            "stepTtlSec": 600
          }
        ]
      },
      {
        "step": "t_shop_qty",
        "buttonIdPrefix": "t_qty_",
        "actions": [
          {
            "remember": "t_sq_{chat}_{senderNumber}",
            "value": "{buttonText}",
            "ttlSec": 900
          },
          {
            "recall": "t_si_{chat}_{senderNumber}",
            "default": "-",
            "saveAs": "it"
          },
          {
            "recall": "t_sp_{chat}_{senderNumber}",
            "default": "0",
            "saveAs": "pr"
          },
          {
            "reply": "🧾 Langkah 3/3\n{it} x {buttonText}\nTotal: Rp {math: {pr} * {buttonText}}\n\nKonfirmasi pesanan?",
            "nextStep": "t_shop_confirm",
            "stepTtlSec": 600,
            "buttons": [
              {
                "type": "quick_reply",
                "id": "t_shop_ok",
                "text": "✅ Pesan"
              },
              {
                "type": "quick_reply",
                "id": "t_shop_no",
                "text": "❌ Batal"
              }
            ]
          }
        ]
      },
      {
        "step": "t_shop_confirm",
        "buttonId": "t_shop_ok",
        "clearStep": true,
        "actions": [
          {
            "recall": "t_si_{chat}_{senderNumber}",
            "default": "-",
            "saveAs": "it"
          },
          {
            "recall": "t_sp_{chat}_{senderNumber}",
            "default": "0",
            "saveAs": "pr"
          },
          {
            "recall": "t_sq_{chat}_{senderNumber}",
            "default": "1",
            "saveAs": "qt"
          },
          {
            "reply": "✅ Pesanan dikonfirmasi\n{it} x {qt}\nTotal: Rp {math: {pr} * {qt}}",
            "buttons": [
              {
                "type": "quick_reply",
                "id": "t_menu",
                "text": "🏠 Menu Template"
              }
            ]
          },
          {
            "forget": "t_si_{chat}_{senderNumber}"
          },
          {
            "forget": "t_sp_{chat}_{senderNumber}"
          },
          {
            "forget": "t_sq_{chat}_{senderNumber}"
          }
        ]
      },
      {
        "step": "t_shop_confirm",
        "buttonId": "t_shop_no",
        "clearStep": true,
        "actions": [
          {
            "reply": "❌ Pesanan dibatalkan."
          }
        ]
      }
    ],
    "onBeforeSend": [
      {
        "enabled": false,
        "messageTypes": [
          "text"
        ],
        "suffix": "\n\n_Dikirim lewat Template Bot_"
      }
    ],
    "onAfterSend": [
      {
        "enabled": false,
        "messageTypes": [
          "text"
        ],
        "actions": [
          {
            "method": "storageAppend",
            "args": {
              "path": "sent.log",
              "content": "{timestamp} {chat} {type}\n"
            }
          }
        ]
      }
    ]
  }
