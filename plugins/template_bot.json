            "scope": "user",
            "reply": "⏳ Tunggu {remaining} dtk."
          },
          {
            "recall": "t_count_{senderNumber}",
            "default": "0",
            "saveAs": "c"
          },
          {
            "remember": "t_count_{senderNumber}",
            "value": "{math: {c} + 1}"
          },
          {
            "when": "{c}",
            "is": "0",
            "then": [
              {
                "reply": "👋 Pertama kali pakai .logic\n🎲 d20: {roll:1d20}"
              }
            ],
            "else": [
              {
                "reply": "🔢 Kamu sudah memakai .logic {math: {c} + 1} kali\n🎲 d20: {roll:1d20}\n🎯 Pilihan acak: {pick:Merah|Biru|Hijau}"
              }
            ]
          }
        ],
